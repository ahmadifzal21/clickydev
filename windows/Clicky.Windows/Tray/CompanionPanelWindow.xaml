<!-- The floating companion panel (Windows counterpart of the NSPanel in MenuBarPanelManager.swift
     and the panelBackground in CompanionPanelView.swift). Borderless, transparent outside the
     rounded card so the drop shadow shows; the outer Margin leaves room for that shadow. -->
<Window x:Class="Clicky.Windows.Tray.CompanionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000"
        Width="352"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="PanelCard"
            Margin="16"
            Width="320"
            Background="{StaticResource DS.Background}"
            BorderBrush="{StaticResource DS.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource DS.CornerRadius.Panel}">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="6" Direction="270" />
        </Border.Effect>
        <StackPanel>
            <!-- Header: status dot + name, status text, close (CompanionPanelView.panelHeader). -->
            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource DS.TextTertiary}">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="StatusDotGlow" ShadowDepth="0" BlurRadius="8" Opacity="0.6" Color="#6B736F" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Margin="8,0,0,0" Text="Clicky" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DS.TextPrimary}" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                           Text="Ready" FontSize="12" FontWeight="Medium" Foreground="{StaticResource DS.TextTertiary}" />
                <Button Grid.Column="2" Style="{StaticResource DS.CircleIconButton}" ToolTip="Close" Click="HandleCloseButtonClick">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" />
                </Button>
            </Grid>

            <Rectangle Height="1" Fill="{StaticResource DS.BorderSubtle}" />

            <!-- Push-to-talk hint. -->
            <Border Margin="16,14,16,0" Padding="12,10" Background="{StaticResource DS.Surface1}"
                    CornerRadius="{StaticResource DS.CornerRadius.Large}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DS.TextSecondary}">
                        <Run Text="Hold" />
                        <Run x:Name="PushToTalkShortcutRun" Text="Ctrl + Alt" FontWeight="SemiBold" Foreground="{StaticResource DS.TextPrimary}" />
                        <Run Text="to talk to Clicky about your screen." />
                    </TextBlock>
                    <!-- Invalid-shortcut / AltGr note (CompanionPanelText.GetShortcutNote). -->
                    <TextBlock x:Name="ShortcutNoteTextBlock" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource DS.TextTertiary}" Visibility="Collapsed" />
                    <!-- Last transcript, speech model download progress, or microphone problem. -->
                    <TextBlock x:Name="VoiceNoteTextBlock" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource DS.TextTertiary}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Show Clicky toggle (CompanionPanelView "Show Clicky Cursor Toggle"). -->
            <Grid Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Show Clicky" FontSize="13" FontWeight="Medium" Foreground="{StaticResource DS.TextPrimary}" />
                    <TextBlock x:Name="ShowClickyDescriptionTextBlock" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DS.TextTertiary}" Text="The blue cursor stays on screen." />
                </StackPanel>
                <ToggleButton x:Name="ShowClickyToggle" Grid.Column="1" VerticalAlignment="Center"
                              AutomationProperties.Name="Show Clicky"
                              Style="{StaticResource DS.ToggleSwitch}"
                              Checked="HandleShowClickyToggleChanged" Unchecked="HandleShowClickyToggleChanged" />
            </Grid>

            <!-- Start with Windows toggle (Windows only; HKCU Run value). -->
            <Grid Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Start with Windows" FontSize="13" FontWeight="Medium" Foreground="{StaticResource DS.TextPrimary}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource DS.TextTertiary}"
                               Text="Clicky opens in the tray when you sign in." />
                </StackPanel>
                <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="1" VerticalAlignment="Center"
                              AutomationProperties.Name="Start with Windows"
                              Style="{StaticResource DS.ToggleSwitch}"
                              Checked="HandleStartWithWindowsToggleChanged" Unchecked="HandleStartWithWindowsToggleChanged" />
            </Grid>

            <!-- Backend routing pickers: rows built in code from BackendRoutingPickerRows. -->
            <TextBlock Margin="16,16,16,6" Text="AI BACKENDS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource DS.TextTertiary}" />
            <StackPanel x:Name="BackendPickersSection" Margin="16,0" />

            <!-- Shown only when clicky.config.json exists but couldn't be parsed. -->
            <Border x:Name="ConfigurationErrorBanner" Visibility="Collapsed" Margin="16,10,16,0" Padding="10,8"
                    Background="#1AFFB224" BorderBrush="{StaticResource DS.Warning}" BorderThickness="1"
                    CornerRadius="{StaticResource DS.CornerRadius.Medium}">
                <TextBlock x:Name="ConfigurationErrorTextBlock" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource DS.Warning}" />
            </Border>

            <Button Margin="8,8,8,0" Style="{StaticResource DS.PanelButton}" Click="HandleOpenConfigurationFileButtonClick">
                <TextBlock Text="Open config file" />
            </Button>

            <Rectangle Height="1" Margin="0,14,0,0" Fill="{StaticResource DS.BorderSubtle}" />

            <Button Margin="8" Style="{StaticResource DS.PanelButton}" Click="HandleQuitButtonClick">
                <TextBlock Text="Quit Clicky" />
            </Button>
        </StackPanel>
    </Border>
</Window>
