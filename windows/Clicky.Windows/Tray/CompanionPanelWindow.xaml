<!-- The floating companion panel (Windows counterpart of the NSPanel in MenuBarPanelManager.swift
     and the panelBackground in CompanionPanelView.swift). Borderless, transparent outside the
     rounded card so the drop shadow shows; the outer Margin leaves room for that shadow. -->
<Window x:Class="Clicky.Windows.Tray.CompanionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000"
        Width="352"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="PanelCard"
            Margin="16"
            Width="320"
            Background="{StaticResource DS.Background}"
            BorderBrush="{StaticResource DS.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource DS.CornerRadius.Panel}">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="6" Direction="270" />
        </Border.Effect>
        <!-- Filled by the panel content (T1.3) and backend pickers (T1.4). -->
        <StackPanel x:Name="PanelContentStack" />
    </Border>
</Window>
