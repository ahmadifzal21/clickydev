<!-- Port of BlueCursorView in leanring-buddy/OverlayWindow.swift: the companion's blue triangle and its
     pointing bubble. The waveform and spinner join this canvas in later tickets. -->
<UserControl x:Class="Clicky.Windows.Overlay.BlueCursorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False">
    <!-- Merged here too so the view also renders when hosted without App.xaml (tests). -->
    <UserControl.Resources>
        <ResourceDictionary Source="../Tray/ClickyDesignSystem.xaml" />
    </UserControl.Resources>
    <Canvas>
        <!-- Mac navigation bubble: 11pt medium white on cursor blue, left edge 10 right of the buddy, centred 18 below. -->
        <Border x:Name="PointingBubble"
                Background="{StaticResource DS.OverlayCursorBlue}"
                CornerRadius="6"
                Padding="8,4"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Hidden">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PointingBubbleScale" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="PointingBubbleGlow"
                                  Color="{StaticResource DS.OverlayCursorBlueColor}"
                                  ShadowDepth="0"
                                  BlurRadius="12"
                                  Opacity="0.5" />
            </Border.Effect>
            <TextBlock x:Name="PointingBubbleText"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="White" />
        </Border>

        <!-- Mac Triangle shape in a 16x16 frame, centroid at the origin so Canvas.Left/Top is its centre. -->
        <Path x:Name="BlueCursorTriangle"
              Fill="{StaticResource DS.OverlayCursorBlue}"
              Data="M 0,-9.2376 L -8,4.6188 L 8,4.6188 Z"
              Visibility="Hidden">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="BlueCursorTriangleRotation" Angle="-35" />
                    <ScaleTransform x:Name="BlueCursorTriangleScale" />
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Effect>
                <!-- SwiftUI .shadow(radius: 8) is a Gaussian radius; WPF's BlurRadius is roughly twice that. -->
                <DropShadowEffect x:Name="BlueCursorTriangleGlow"
                                  Color="{StaticResource DS.OverlayCursorBlueColor}"
                                  ShadowDepth="0"
                                  BlurRadius="16"
                                  Opacity="1" />
            </Path.Effect>
        </Path>
    </Canvas>
</UserControl>
