<?xml version="1.0" encoding="utf-8"?>
<!-- Pin package restore to nuget.org so the Windows port builds the same on every
     machine, regardless of the user-level NuGet.Config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
